# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/podintel
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/podintel

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Qdrant
QDRANT_URL=http://localhost:6333

# Object storage (S3-compatible; MinIO for local dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=podintel-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Anthropic Claude — module 4 (LLM-Based Podcast Intelligence)
ANTHROPIC_API_KEY=
CLAUDE_SONNET_MODEL=claude-sonnet-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# Voyage AI — module 6 (Semantic Search embeddings)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Speech-to-text — module 3 (Transcription)
DEEPGRAM_API_KEY=

# Admin
ADMIN_API_KEY=change-me

# Feed poller
FEED_POLL_INTERVAL_SECONDS=1800
PIPELINE_MAX_ATTEMPTS=3
